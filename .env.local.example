# 실제 값을 채운 뒤 파일명을 .env.local 로 변경하세요. (.env.local은 git에 커밋되지 않습니다)

# 배포될 사이트 주소 (메타태그, sitemap, OG 태그에 사용)
NEXT_PUBLIC_SITE_URL=https://seniorhealth.homes

# 사이트 이름 (비워두면 "건강한 노후" 사용)
NEXT_PUBLIC_SITE_NAME=

# 운영자 소개/문의 페이지에 표시할 정보
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# 구글 애드센스 승인 후 발급되는 클라이언트 ID (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6304657588983422

# 구글 애널리틱스(GA4) 측정 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# /admin 에서 저장 시 git commit+push 자동 실행 여부 (기본값 true)
# 자동 반영을 끄고 싶으면 false로 설정하세요.
ADMIN_AUTO_GIT_SYNC=true
